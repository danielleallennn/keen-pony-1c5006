{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/adhd-always-on.mjs"],
            "timeout": 5,
            "statusMessage": "Loading ADHD-mode ruleset..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/adhd-opt-out-tracker.mjs"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
